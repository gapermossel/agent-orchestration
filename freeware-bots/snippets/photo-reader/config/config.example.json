{
  "bot_name": "photo-reader",
  "job": "bot.jobs.photo_reader:PhotoReaderJob",
  "data_dir": "data",
  "log_level": "INFO",
  "library_src": "./vendor/src",
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "chat_model": "qwen3:8b",
    "timeout_s": 120
  },
  "memory": {
    "backend": "sqlite",
    "path": "data/memory.sqlite3",
    "history_turns": 6
  },
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8091,
    "max_body_bytes": 10485760
  },
  "telegram": {
    "enabled": false,
    "token_env": "TELEGRAM_BOT_TOKEN"
  },
  "discord": {
    "enabled": false,
    "token_env": "DISCORD_BOT_TOKEN"
  },
  "matrix": {
    "enabled": false,
    "homeserver_env": "MATRIX_HOMESERVER",
    "user_id_env": "MATRIX_USER_ID",
    "access_token_env": "MATRIX_ACCESS_TOKEN"
  },
  "template_version": "0.1.2",
  "photo": {
    "mode": "both",
    "ocr": {
      "engine": "tesseract",
      "tesseract_cmd": "tesseract",
      "lang": "eng",
      "tessdata_dir": null,
      "psm": 3,
      "timeout_s": 60
    },
    "vision": {
      "model": "qwen3-vl:8b",
      "prompt": "Describe this image in two or three plain English sentences. If it contains text, say what kind of document or sign it is.",
      "think": false,
      "timeout_s": 900
    }
  }
}
